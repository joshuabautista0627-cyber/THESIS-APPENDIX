CMBLOCK,_CM99UZ_ZP,NODE,       18
(8i10)
      6719      6737      6754      6785      6786      6819      6820      6825
      6826      6995     -6997      7033      7066      7114     -7116      7167
     -7169      7174
cmsel,s,_CM99UZ_ZP
d,all,uz,-1.25
nsel,all

/com,*** Component For All Non-Zero UZ Displacements ***
cmsel,s,_CM99uz_zp
cm,_DISPNONZEROUZ,NODE
nsel,all

/nopr
/gopr
autots,on                   ! User turned on automatic time stepping
nsub,20,500,5,OFF
time,1.
outres,erase
outres,all,none
outres,nsol,all,
outres,rsol,all
outres,eangl,all
outres,etmp,all
outres,veng,all
outres,strs,all,
outres,epel,all,
outres,eppl,all,
outres,cont,all,
