CMBLOCK,_CM102UZ_ZP,NODE,       18
(8i10)
      5091      5110      5128      5161      5162      5197      5198      5203
      5204      5384     -5386      5424      5459      5510     -5512      5566
     -5568      5573
cmsel,s,_CM102UZ_ZP
d,all,uz,-1.25
nsel,all

/com,*** Component For All Non-Zero UZ Displacements ***
cmsel,s,_CM102uz_zp
cm,_DISPNONZEROUZ,NODE
nsel,all

/nopr
/gopr
autots,on                   ! User turned on automatic time stepping
nsub,50,500,20,OFF
time,1.
outres,erase
outres,all,none
outres,nsol,all,
outres,rsol,all
outres,eangl,all
outres,etmp,all
outres,veng,all
outres,strs,all,
outres,epel,all,
outres,eppl,all,
outres,cont,all,
