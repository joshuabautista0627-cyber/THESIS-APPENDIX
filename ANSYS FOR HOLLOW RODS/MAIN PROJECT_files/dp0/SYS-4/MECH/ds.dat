CMBLOCK,_CM99UZ_ZP,NODE,       18
(8i10)
      7573      7591      7608      7639      7640      7673      7674      7679
      7680      7849     -7851      7887      7920      7968     -7970      8021
     -8023      8028
cmsel,s,_CM99UZ_ZP
d,all,uz,-1.25
nsel,all

/com,*** Component For All Non-Zero UZ Displacements ***
cmsel,s,_CM99uz_zp
cm,_DISPNONZEROUZ,NODE
nsel,all

/nopr
/gopr
autots,on                   ! User turned on automatic time stepping
nsub,20,500,5,OFF
time,1.
outres,erase
outres,all,none
outres,nsol,all,
outres,rsol,all
outres,eangl,all
outres,etmp,all
outres,veng,all
outres,strs,all,
outres,epel,all,
outres,eppl,all,
outres,cont,all,
