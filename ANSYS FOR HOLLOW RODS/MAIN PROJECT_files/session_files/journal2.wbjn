# encoding: utf-8
# 2025 R2
SetScriptVersion(Version="25.2.170")
system1 = GetSystem(Name="SYS 1")
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
system2 = GetSystem(Name="SYS 2")
model2 = system2.GetContainer(ComponentName="Model")
model2.Edit()
model1.Exit()
system3 = GetSystem(Name="SYS 9")
modelComponent1 = system3.GetComponent(Name="Model")
modelComponent1.Refresh()
model3 = system3.GetContainer(ComponentName="Model")
model3.Edit()
system4 = GetSystem(Name="SYS 4")
modelComponent2 = system4.GetComponent(Name="Model")
modelComponent2.Refresh()
model4 = system4.GetContainer(ComponentName="Model")
model4.Edit()
model3.Exit()
model2.Exit()
system5 = GetSystem(Name="SYS 7")
modelComponent3 = system5.GetComponent(Name="Model")
modelComponent3.Refresh()
model5 = system5.GetContainer(ComponentName="Model")
model5.Edit()
Save(Overwrite=True)
model5.Exit()
