# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = template1.CreateSystem()
engineeringData1 = system1.GetContainer(ComponentName="Engineering Data")
matl1 = engineeringData1.CreateMaterial(Name="ECOFLEX 00-45")
matlProp1 = matl1.CreateProperty(
    Name="Density",
    Qualifiers={"Definition": "", "Behavior": ""})
matlProp2 = matl1.CreateProperty(
    Name="Neo-Hookean",
    Qualifiers={"Definition": "", "Behavior": ""})
matlProp1.SetData(
    Index=-1,
    Variables=["Density"],
    Values=[["1060 [kg m^-3]"]])
matlProp2.SetVariableProperty(
    VariableName="Incompressibility Parameter D1",
    Property="Unit",
    Value="MPa^-1")
matlProp2.SetVariableProperty(
    VariableName="Initial Shear Modulus Mu",
    Property="Unit",
    Value="MPa")
matlProp2.SetData(
    Index=-1,
    Variables=["Incompressibility Parameter D1"],
    Values=[["0.424 [MPa^-1]"]])
matlProp2.SetData(
    Variables=["Initial Shear Modulus Mu"],
    Values=[["0.0473 [MPa]"]])
system1.Copy(KeepConnections=True)
system2 = GetSystem(Name="SYS 1")
system2.Copy(KeepConnections=True)
system3 = GetSystem(Name="SYS 2")
system3.Copy(KeepConnections=True)
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath="C:/Users/DLSU/Downloads/RUN 6_SOLID.step")
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.SetFile(FilePath="C:/Users/DLSU/Downloads/RUN 6.step")
geometry3 = system3.GetContainer(ComponentName="Geometry")
geometry3.SetFile(FilePath="C:/Users/DLSU/Downloads/RUN 6 (8MM).step")
system4 = GetSystem(Name="SYS 3")
geometry4 = system4.GetContainer(ComponentName="Geometry")
geometry4.SetFile(FilePath="C:/Users/DLSU/Downloads/RUN 6 (6MM).step")
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
model1.Edit()
model1.Exit()
Save(Overwrite=True)
