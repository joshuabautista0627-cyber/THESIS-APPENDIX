CMBLOCK,_CM129UZ_ZP,NODE,       18
(8i10)
      9537      9555      9572      9603      9604      9637      9638      9643
      9644      9813     -9815      9851      9884      9932     -9934      9985
     -9987      9992
cmsel,s,_CM129UZ_ZP
d,all,uz,%_loadvari129zp%
nsel,all

/com,*** Component For All Non-Zero UZ Displacements ***
cmsel,s,_CM129uz_zp
cm,_DISPNONZEROUZ,NODE
nsel,all

