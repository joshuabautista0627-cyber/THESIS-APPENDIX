# encoding: utf-8
# 2025 R2
SetScriptVersion(Version="25.2.170")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = template1.CreateSystem()
engineeringData1 = system1.GetContainer(ComponentName="Engineering Data")
matl1 = engineeringData1.CreateMaterial(Name="ECOFLEX-0045")
matlProp1 = matl1.CreateProperty(
    Name="Density",
    Qualifiers={"Definition": "", "Behavior": ""})
matlProp2 = matl1.CreateProperty(
    Name="Neo-Hookean",
    Qualifiers={"Definition": "", "Behavior": ""})
matlProp2.SetVariableProperty(
    VariableName="Initial Shear Modulus Mu",
    Property="Unit",
    Value="MPa")
matlProp2.SetVariableProperty(
    VariableName="Incompressibility Parameter D1",
    Property="Unit",
    Value="MPa^-1")
matlProp1.SetData(
    Index=-1,
    Variables=["Density"],
    Values=[["1060 [kg m^-3]"]])
matlProp2.SetData(
    Index=-1,
    Variables=["Initial Shear Modulus Mu"],
    Values=[["0.0473 [MPa]"]])
matlProp2.SetData(
    Variables=["Incompressibility Parameter D1"],
    Values=[["0.424 [MPa^-1]"]])
system1.Copy(KeepConnections=True)
system2 = GetSystem(Name="SYS 1")
system3 = system2.Duplicate(
    ComponentsToShare=[],
    RelativeTo=system2)
system3.Copy(KeepConnections=True)
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath="C:/Users/DLSU/Downloads/ANSYS FOR HOLLOW RODS/RUN 1.step")
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.SetFile(FilePath="C:/Users/DLSU/Downloads/ANSYS FOR HOLLOW RODS/RUN 5.step")
model1.Exit()
modelComponent2 = system2.GetComponent(Name="Model")
modelComponent2.Refresh()
model2 = system2.GetContainer(ComponentName="Model")
model2.Edit()
model2.Exit()
geometry3 = system3.GetContainer(ComponentName="Geometry")
geometry3.SetFile(FilePath="C:/Users/DLSU/Downloads/ANSYS FOR HOLLOW RODS/RUN 7.step")
modelComponent3 = system3.GetComponent(Name="Model")
modelComponent3.Refresh()
model3 = system3.GetContainer(ComponentName="Model")
model3.Edit()
system4 = GetSystem(Name="SYS 3")
geometry4 = system4.GetContainer(ComponentName="Geometry")
geometry4.SetFile(FilePath="C:/Users/DLSU/Downloads/ANSYS FOR HOLLOW RODS/RUN 8.step")
modelComponent4 = system4.GetComponent(Name="Model")
modelComponent4.Refresh()
model3.Exit()
model4 = system4.GetContainer(ComponentName="Model")
model4.Edit()
model4.Exit()
Save(Overwrite=True)
